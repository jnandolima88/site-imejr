DirectoryIndex index.html

# Keep image files out of search indexes, including when linked by other sites.
# Do not disallow these URLs in robots.txt: crawlers must read this header.
<IfModule mod_headers.c>
  <FilesMatch "(?i)\.(avif|bmp|gif|ico|jpe?g|png|svg|tiff?|webp)$">
    Header always set X-Robots-Tag "noindex, noimageindex"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Serve Next static-export pages without requiring the .html extension.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
